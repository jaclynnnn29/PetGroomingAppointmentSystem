@model IEnumerable<PetGroomingSystem.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="alert alert-warning">
    <strong>Debug Info:</strong> The system is currently searching for appointments belonging to this email:
    <span class="text-danger">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
</div>

<h2 class="mb-4">My Appointments</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have no upcoming grooming appointments. <a asp-action="Create" class="alert-link">Book one now!</a>
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Booking ID</th>
                <th>Service</th>
                <th>Date</th>
                <th>Time Slot</th>
                <th>Status</th>
                <th>Payment</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>#@item.Id</td>
                    <td>@item.GroomingService?.Name</td>
                    <td>@item.Date.ToString("yyyy-MM-dd")</td>
                    <td>@item.TimeSlot</td>
                    <td>
                        @if (item.Status == "Cancelled")
                        {
                            <span class="badge bg-danger">Cancelled</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@item.Status</span>
                        }
                    </td>
                    <td>
                        @if (item.IsPaid)
                        {
                            <span class="badge bg-success">Paid ✓</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Unpaid</span>
                        }
                    </td>
                    <td>
                        <a asp-action="AppointmentDetail" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white me-1">Details</a>

                        @if (item.IsPaid)
                        {
                            <a asp-controller="Payment" asp-action="DownloadReceipt" asp-route-appointmentId="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                📄 Receipt
                            </a>
                        }
                        else if (item.Status != "Cancelled")
                        {
                            <a asp-controller="Payment" asp-action="CreateCheckoutSession" asp-route-appointmentId="@item.Id" class="btn btn-sm btn-success me-1">
                                💳 Pay Now
                            </a>
                        }

                        @if (item.Status != "Cancelled")
                        {
                            <form asp-controller="Booking" asp-action="CancelAppointment" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}