@model IEnumerable<PetGroomingSystem.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="alert alert-warning mb-4 shadow-sm">
    <strong>Debug Info:</strong> Searching appointments for:
    <span class="fw-bold text-danger">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
</div>

<h2 class="mb-4 text-body fw-bold">My Appointments</h2>

@if (!Model.Any())
{
    <div class="alert alert-info shadow-sm">
        You have no upcoming grooming appointments. <a asp-action="Create" class="alert-link">Book one now!</a>
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="py-3">Booking ID</th>
                    <th class="py-3">Service</th>
                    <th class="py-3">Date</th>
                    <th class="py-3">Time Slot</th>
                    <th class="py-3">Status</th>
                    <th class="py-3">Payment</th>
                    <th class="py-3 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">#@item.Id</td>
                        <td>@item.GroomingService?.Name</td>
                        <td>@item.Date.ToString("yyyy-MM-dd")</td>
                        <td>@item.TimeSlot</td>
                        <td>
                            @if (item.Status == "Cancelled")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">@item.Status</span>
                            }
                        </td>
                        <td>
                            @if (item.IsPaid)
                            {
                                <span class="badge bg-success px-2 py-1">Paid ✓</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-2 py-1">Unpaid</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center gap-1">
                                <a asp-action="AppointmentDetail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                    Details
                                </a>

                                @if (item.IsPaid)
                                {
                                    <a asp-controller="Payment" asp-action="DownloadReceipt" asp-route-appointmentId="@item.Id" class="btn btn-sm btn-outline-primary">
                                        📄 Receipt
                                    </a>
                                }
                                else if (item.Status != "Cancelled")
                                {
                                    <a asp-controller="Payment" asp-action="CreateCheckoutSession" asp-route-appointmentId="@item.Id" class="btn btn-sm btn-success">
                                        💳 Pay Now
                                    </a>
                                }

                                @if (item.Status != "Cancelled")
                                {
                                    <form asp-controller="Booking" asp-action="CancelAppointment" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}