@model IEnumerable<PetGroomingSystem.Models.GroomingService>

<h2 class="mb-4">Our Grooming Services</h2>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card p-3 shadow-sm">
                <h4>@item.Name</h4>
                <p>@item.Description</p>
                <p class="text-success fw-bold">Price: $RM @item.Price</p>
                <a asp-action="Create" class="btn btn-primary">Book Now</a>
            </div>
        </div>
    }
</div>