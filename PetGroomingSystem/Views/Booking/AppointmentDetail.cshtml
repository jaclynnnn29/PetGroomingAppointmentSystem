@model PetGroomingSystem.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<h2 class="mb-4">Appointment Details (#@Model.Id)</h2>

<div class="card shadow-sm p-4 col-md-8">
    <dl class="row fs-5">
        <dt class="col-sm-4">Service Name:</dt>
        <dd class="col-sm-8">@Model.GroomingService?.Name</dd>

        <dt class="col-sm-4">Price:</dt>
        <dd class="col-sm-8 text-success fw-bold">RM @Model.GroomingService?.Price.ToString("F2")</dd>

        <dt class="col-sm-4">Date:</dt>
        <dd class="col-sm-8">@Model.Date.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-4">Time Slot:</dt>
        <dd class="col-sm-8">@Model.TimeSlot</dd>

        <dt class="col-sm-4">Special Requests:</dt>
        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.SpecialRequests) ? "None" : Model.SpecialRequests)</dd>

        <dt class="col-sm-4">Status:</dt>
        <dd class="col-sm-8"><span class="badge bg-success">@Model.Status</span></dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Appointments" class="btn btn-secondary">Back to My Appointments</a>
    </div>
</div>