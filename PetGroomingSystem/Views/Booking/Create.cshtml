@model PetGroomingSystem.ViewModels.BookingAppointmentVM

<h2 class="mb-4">Book a Pet Grooming Appointment</h2>

<form asp-action="Create" method="post" class="col-md-6">
    <!-- Service Selection -->
    <div class="mb-3">
        <label asp-for="ServiceId" class="form-label fw-bold">Select Service</label>
        <select asp-for="ServiceId" asp-items="ViewBag.ServicesList" class="form-select">
            <option value="">-- Choose Service --</option>
        </select>
        <span asp-validation-for="ServiceId" class="text-danger"></span>
    </div>

    <!-- Pet Type (Dog / Cat Only) -->
    <div class="mb-3">
        <label class="form-label fw-bold">Pet Type</label>
        <div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="PetType" value="Dog" id="petDog" checked>
                <label class="form-check-label" for="petDog">🐶 Dog</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="PetType" value="Cat" id="petCat">
                <label class="form-check-label" for="petCat">🐱 Cat</label>
            </div>
        </div>
        <span asp-validation-for="PetType" class="text-danger"></span>
    </div>

    <!-- Pet Name -->
    <div class="mb-3">
        <label asp-for="PetName" class="form-label fw-bold">Pet Name</label>
        <input asp-for="PetName" class="form-control" placeholder="e.g., Buddy" />
        <span asp-validation-for="PetName" class="text-danger"></span>
    </div>

    <!-- Date Selection -->
    <div class="mb-3">
        <label asp-for="AppointmentDate" class="form-label fw-bold">Appointment Date</label>
        <!-- We add id="AppointmentDate" so our JavaScript can detect when it changes -->
        <input asp-for="AppointmentDate" id="AppointmentDate" class="form-control" type="date" />
        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
    </div>

    <!-- Interactive Time Slot Selection -->
    <div class="mb-3">
        <label class="form-label fw-bold">Available Time Slots</label>

        <!-- This empty div is where our JavaScript will generate the buttons -->
        <div id="timeSlotContainer" class="d-flex flex-wrap gap-2 mt-2">
            <div class="alert alert-secondary w-100 text-center mb-0 py-2">
                📅 Please select a date above to see available time slots.
            </div>
        </div>

        <span asp-validation-for="TimeSlot" class="text-danger mt-2 d-block"></span>
    </div>

    <!-- Special Requests -->
    <div class="mb-3">
        <label asp-for="SpecialRequests" class="form-label fw-bold">Special Requests</label>
        <textarea asp-for="SpecialRequests" class="form-control" rows="3" placeholder="Any specific requirements or notes for the groomer..."></textarea>
        <span asp-validation-for="SpecialRequests" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Confirm Booking</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            // When the user changes the Date input...
            $('#AppointmentDate').change(function () {
                var selectedDate = $(this).val();
                var container = $('#timeSlotContainer');

                if (!selectedDate) {
                    container.html('<div class="alert alert-secondary w-100 text-center mb-0 py-2">📅 Please select a date above to see available time slots.</div>');
                    return;
                }

                container.html('<div class="text-muted">Searching for available slots...</div>');

                // Call our controller method
                $.get('/Booking/GetAvailableTimeSlots', { date: selectedDate }, function (slots) {
                    container.empty();

                    if (slots.length === 0) {
                        container.html('<div class="alert alert-danger w-100 text-center mb-0 py-2">No available slots for this date. Please pick another day.</div>');
                        return;
                    }

                    // Loop through available slots and generate clickable buttons
                    $.each(slots, function (index, slot) {
                        var safeId = slot.replace(/[: ]/g, ''); // Removes spaces/colons for HTML IDs

                        var html = `
                            <div>
                                <input type="radio" class="btn-check" name="TimeSlot" id="slot_${safeId}" value="${slot}" required>
                                <label class="btn btn-outline-primary px-4" for="slot_${safeId}">${slot}</label>
                            </div>
                        `;
                        container.append(html);
                    });
                });
            });
        });
    </script>
}