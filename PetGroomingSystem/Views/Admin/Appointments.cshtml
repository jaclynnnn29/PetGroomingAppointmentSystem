@model IEnumerable<PetGroomingSystem.Models.Appointment>

@{
    ViewData["Title"] = "Manage Appointments";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Appointments</h2>
        <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Date</th>
                <th>Time Slot</th>
                <th>Member Email</th>
                <th>Pet Name</th>
                <th>Service</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Date</td>
                    <td>@item.TimeSlot</td>
                    <td>@item.MemberEmail</td>
                    <td>@item.PetName (@item.PetType)</td>
                    <td>@item.GroomingService?.Name</td>
                    <td><span class="badge bg-primary">@item.Status</span></td>
                    <td>
                        <form asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="status" value="Cancelled" />
                            <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>