@model IEnumerable<PetGroomingSystem.Models.Appointment>

@{
    ViewData["Title"] = "Manage Appointments";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-body fw-bold m-0">Manage Appointments</h2>
        <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            No appointments found in the system.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm bg-body-tertiary">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="py-3 ps-3">Date</th>
                                <th class="py-3">Time Slot</th>
                                <th class="py-3">Member Email</th>
                                <th class="py-3">Pet Name</th>
                                <th class="py-3">Service</th>
                                <th class="py-3">Status</th>
                                <th class="py-3 text-center pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@item.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@item.TimeSlot</td>
                                    <td><span class="text-body-secondary">@item.MemberEmail</span></td>
                                    <td class="fw-medium">@item.PetName (@item.PetType)</td>
                                    <td>@item.GroomingService?.Name</td>
                                    <td>
                                        @if (item.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">@item.Status</span>
                                        }
                                    </td>
                                    <td class="text-center pe-3">
                                        @if (item.Status != "Cancelled")
                                        {
                                            <form asp-action="UpdateAppointmentStatus" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="status" value="Cancelled" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-secondary opacity-50" disabled>Cancelled</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>