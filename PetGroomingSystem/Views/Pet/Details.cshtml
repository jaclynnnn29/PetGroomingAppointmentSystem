@model PetGroomingSystem.Models.Pet

@{
    ViewData["Title"] = "Pet Details";
}

<h2>Pet Details</h2>

<div class="card shadow-sm mt-4" style="max-width: 700px;">
    <div class="card-body">

        <h3 class="card-title mb-4">@Model.PetName</h3>

        <dl class="row">

            <dt class="col-sm-4">
                Pet Type
            </dt>
            <dd class="col-sm-8">
                @Model.PetType
            </dd>

            <dt class="col-sm-4">
                Breed
            </dt>
            <dd class="col-sm-8">
                @(string.IsNullOrEmpty(Model.Breed) ? "Not specified" : Model.Breed)
            </dd>

            <dt class="col-sm-4">
                Gender
            </dt>
            <dd class="col-sm-8">
                @Model.Gender
            </dd>

            <dt class="col-sm-4">
                Age
            </dt>
            <dd class="col-sm-8">
                @Model.Age years
            </dd>

            <dt class="col-sm-4">
                Weight
            </dt>
            <dd class="col-sm-8">
                @Model.Weight kg
            </dd>

            <dt class="col-sm-4">
                Medical Notes
            </dt>
            <dd class="col-sm-8">
                @(string.IsNullOrEmpty(Model.MedicalNotes)
                    ? "No medical notes"
                    : Model.MedicalNotes)
            </dd>

        </dl>

        <hr />

        <!-- Pet Photos -->
        <h4 class="mt-4">Pet Photos</h4>

        @if (Model.Photos != null && Model.Photos.Any())
        {
            <div class="row mt-3">

                @foreach (var photo in Model.Photos)
                {
                    <div class="col-md-4 mb-3">

                        <img src="@photo.PhotoPath"
                             alt="@Model.PetName"
                             class="img-fluid rounded shadow-sm"
                             style="width: 100%; height: 180px; object-fit: cover;" />

                    </div>
                }

            </div>
        }
        else
        {
            <p class="text-muted">
                No photos uploaded yet.
            </p>
        }

        <!-- Upload Photo -->
        <form asp-action="UploadPhoto"
              method="post"
              enctype="multipart/form-data"
              class="mt-3">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="petId"
                   value="@Model.PetID" />

            <div class="mb-3">
                <label class="form-label">
                    Upload Pet Photo
                </label>

                <input type="file"
                       name="photo"
                       class="form-control"
                       accept="image/*"
                       required />
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Upload Photo
            </button>

        </form>

        <div class="mt-4">

            <a asp-action="Edit"
               asp-route-id="@Model.PetID"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.PetID"
               class="btn btn-danger">
                Delete
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to My Pets
            </a>

        </div>

    </div>
</div>