@model IEnumerable<PetGroomingSystem.Models.Pet>

@{
    ViewData["Title"] = "My Pets";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Pets</h2>

    <div class="d-flex gap-2">

        <!-- Search Pet -->
        <form asp-action="Index" method="get" class="d-flex">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search pet..."
                   style="width: 200px;" />

            <button type="submit" class="btn btn-outline-primary ms-2">
                🔍 Search
            </button>
        </form>

        <a asp-action="Create" class="btn btn-primary">
            + Add Pet
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have not added any pets yet.
    </div>
}
else
{
    <div class="row">
        @foreach (var pet in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    @if (pet.Photos != null && pet.Photos.Any())
                    {
                        <img src="@pet.Photos.First().PhotoPath" class="card-img-top" alt="@pet.PetName" style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body">

                        <h4>@pet.PetName</h4>

                        <p>
                            <strong>Type:</strong> @pet.PetType
                        </p>

                        <p>
                            <strong>Breed:</strong> @pet.Breed
                        </p>

                        <p>
                            <strong>Gender:</strong> @pet.Gender
                        </p>

                        <p>
                            <strong>Age:</strong> @pet.Age
                        </p>

                        <p>
                            <strong>Weight:</strong> @pet.Weight kg
                        </p>

                        <div class="mt-3">
                            <a asp-action="Details"
                               asp-route-id="@pet.PetID"
                               class="btn btn-info btn-sm">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@pet.PetID"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@pet.PetID"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}