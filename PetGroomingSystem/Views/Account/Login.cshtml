@model PetGroomingSystem.ViewModels.LoginVM

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <h2>Login</h2><form asp-action="Login" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>

                <input asp-for="Email"
                       class="form-control"
                       type="email" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Password"
                       class="form-label">
                </label>

                <input asp-for="Password"
                       class="form-control"
                       type="password" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

                <div class="mt-1">
                    <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none">
                        Forgot password?
                    </a>
                </div>
            </div>

            <!-- CAPTCHA -->
            <div class="mb-3">

                <label class="form-label">
                    @ViewData["CaptchaQuestion"]
                </label>

                <input asp-for="CaptchaUserAnswer"
                       class="form-control"
                       type="number" />

                <span asp-validation-for="CaptchaUserAnswer"
                      class="text-danger">
                </span>

            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe"
                       class="form-check-input" />

                <label asp-for="RememberMe"
                       class="form-check-label">
                    Remember Me
                </label>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Login
            </button>

            <a asp-action="Register"
               class="btn btn-secondary">
                Register
            </a></form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}