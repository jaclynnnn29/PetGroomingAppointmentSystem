@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="mb-4 text-center fw-bold text-body">@ViewData["Title"]</h1>

        <div class="card border-0 shadow-sm bg-body-tertiary">
            <div class="card-body p-4">
                <p class="text-body-secondary lead mb-4">
                    Use this page to detail your site's privacy policy.
                </p>

                <h5 class="fw-bold mb-2">1. Information Collection</h5>
                <p class="text-body-secondary small mb-3">
                    We collect personal information such as member emails, pet details, and appointment schedules solely to provide and improve our pet grooming services.
                </p>

                <h5 class="fw-bold mb-2">2. Data Usage</h5>
                <p class="text-body-secondary small mb-3">
                    Your information is strictly used for managing bookings, sending email confirmations, and processing secure payments.
                </p>

                <h5 class="fw-bold mb-2">3. Security</h5>
                <p class="text-body-secondary small mb-0">
                    We implement standard industry encryption and secure data handling to ensure your credentials and personal records remain safe.
                </p>
            </div>
        </div>
    </div>
</div>